#!/bin/sh
# SP970 nat.start — WiFi(192.168.4.x) -> 4G(wwan0) NAT 转发
#
# Layer 1: 系统服务 (OpenRC local.d)
# 依赖: Layer 0 (modem/wwan0) + sim-activate.start (已拉起 wwan0)
# 产出: ip_forward + MASQUERADE (随身 WiFi 形态)
echo 1 > /proc/sys/net/ipv4/ip_forward
iptables -t nat -C POSTROUTING -o wwan0 -j MASQUERADE 2>/dev/null || \
    iptables -t nat -A POSTROUTING -o wwan0 -j MASQUERADE
