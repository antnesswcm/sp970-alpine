#!/bin/sh
# sp970-link — SP970 modem link status/control interface (device-side, Alpine v5)
# Usage: sp970-link {card|status [--ping]|detail|netcheck|up [--check]}
# Output: one-line JSON (machine-readable), except detail (pretty text).
#
# v2 优化 (2026-08-30, 第一性原理复盘后):
#   P2  card 四态: present-ready / present-detected / absent / unknown
#       unknown = 查询失败(QMI 通道挂死等), 与 "modem 确认无卡" 区分,
#       不再把"没查到"谎报成 absent (避免误导恢复动作)。
#   P1  status 与外网 ping 解耦: link_state 只反映 modem 事实;
#       ping 字段默认 na, status --ping 才探测; 外网连通性归 netcheck。
#   P3  link 六态: up / activating / no-card / card-no-net / net-down / unknown
#       activating 表达 MM 过渡期 (注册/使能/冷启动 ~40s 窗口 坑#8)。
#   P6  BDMUX 路径动态查找, 不硬编码 4080000 (坑#1 remoteproc 编号动态)。
#   P5  up --check 只读预检, 报告卡/链路/计划动作, 不动系统。
#
# Stable parsing (已按实测格式校准):
#   - mmcli -m any -K   : "key : value" 无 ANSI; 用 sed 取 modem.generic.state 等
#   - ip -o addr show   : oneline, 稳定; 取 inet
#   - qmicli            : --uim-get-card-status 本身无 ANSI (strip 仅兜底)
#   - pgrep MM          : grep -v pgrep 排除自身匹配 (坑#2.5)
#
# 坑规避: qmicli -p (MM 在跑) / -d (MM 停) 自适应 (坑#2);
#         绝不 ip link set wwan0 up (坑#3); up 复用 sim-activate.start (已验证);
#         状态锚定 modem.generic.state 排除 power/packet service state。

QMI_DEV=/dev/wwan0qmi0
PING_TARGET=223.5.5.5
SIM_ACT=/etc/local.d/sim-activate.start
QMI=$(command -v qmicli || echo /usr/bin/qmicli)

# bam-dmux runtime_status: 按 name 动态找 (坑#1), 找不到则为空
# 实际路径: soc/<remoteproc>/<remoteproc>:bam-dmux (两层)
find_bdmux() {
    for d in /sys/devices/platform/soc/*/*bam-dmux*; do
        [ -d "$d" ] && { echo "$d"; return 0; }
    done
    return 1
}
BDMUX=$(find_bdmux)/power/runtime_status
[ "$BDMUX" = "/power/runtime_status" ] && BDMUX=""

# ---- helpers ----
# MM 在跑? (pgrep -f 会自匹配 pgrep 自身, 用 grep -v pgrep 排除; 也匹配 supervise-daemon, 即 MM 系统在跑)
mm_running() { pgrep -f '/usr/sbin/ModemManager' 2>/dev/null | grep -v pgrep >/dev/null 2>&1; }

# qmicli 自适应: MM 在跑 -p (proxy 避免抢通道 坑#2), 否则 -d 直连
qmi() {
    if mm_running; then sudo -n "$QMI" -p -d "$QMI_DEV" "$@"; else sudo -n "$QMI" -d "$QMI_DEV" "$@"; fi
}
strip_ansi() { sed 's/.\[[0-9;]*m//g'; }

# ---- card (四态: present-ready/present-detected/absent/unknown) ----
# 全局: CARD_SLOT1, CARD_USIM, CARD_STATE
collect_card() {
    out=$(qmi --uim-get-card-status 2>&1 | strip_ansi)
    if echo "$out" | grep -q "Card state: 'present'"; then
        CARD_SLOT1=present
        # usim 的 application state: "Application type: usim" 的下一行 (busybox awk 不稳, 用 sed n)
        CARD_USIM=$(echo "$out" | sed -n "/Application type:.*usim/{n;p}" | sed -n "s/.*Application state: '\([a-z-]*\)'.*/\1/p")
        [ -z "$CARD_USIM" ] && CARD_USIM=unknown
        if [ "$CARD_USIM" = ready ]; then CARD_STATE=present-ready
        else CARD_STATE=present-detected; fi
    else
        CARD_SLOT1=$(echo "$out" | sed -n "s/.*Card state: '\([^']*\)'.*/\1/p" | head -1)
        CARD_USIM=none
        if [ -z "$CARD_SLOT1" ]; then
            # 无 "Card state" 输出 = 查询失败(QMI 通道挂死/未就绪), 不是确认无卡
            CARD_SLOT1=unknown
            CARD_STATE=unknown
        else
            # modem 明确报告非 present (absent / error: possibly-removed (6) 等)
            CARD_STATE=absent
        fi
    fi
}

# ---- status (link 六态, 不掺外网探测) ----
# 全局: CARD, MM_RUNNING, MM_STATE, NAS, WWAN_IP, DR, BDMUX_V, LINK, MM_SIGNAL, MM_OP
# link_state 六态:
#   up         : MM connected + wwan0 有 IP (数据面建立)
#   activating : 卡在 + MM 在跑但未 connected (注册/使能/冷启动 ~40s 窗口 坑#8)
#   no-card    : modem 确认无卡
#   card-no-net: 卡在但 MM 未跑 (还没拉起)
#   net-down   : MM 在跑但失败 (failed)
#   unknown    : 卡状态查询失败, 链路无法判定
collect_status() {
    collect_card
    CARD=$CARD_STATE
    if mm_running; then
        MM_RUNNING=true
        mmk=$(mmcli -m any -K 2>/dev/null)
        MM_STATE=$(echo "$mmk" | sed -n 's/^modem\.generic\.state[[:space:]]*:[[:space:]]*\(.*\)$/\1/p' | head -1)
        [ -z "$MM_STATE" ] && MM_STATE=unknown
        MM_SIGNAL=$(echo "$mmk" | sed -n 's/^modem\.generic\.signal-quality\.value[[:space:]]*:[[:space:]]*\(.*\)$/\1/p' | head -1)
        MM_OP=$(echo "$mmk" | sed -n 's/^modem\.3gpp\.operator-name[[:space:]]*:[[:space:]]*\(.*\)$/\1/p' | head -1)
    else
        MM_RUNNING=false; MM_STATE=stopped; MM_SIGNAL=na; MM_OP=na
    fi
    NAS=$(qmi --nas-get-serving-system 2>&1 | strip_ansi | grep -q "Registration state: 'registered'" && echo registered || echo not-registered)
    WWAN_IP=$(/sbin/ip -o addr show wwan0 2>/dev/null | sed -n 's/.*inet \([0-9.]*\).*/\1/p' | head -1)
    [ -z "$WWAN_IP" ] && WWAN_IP=none
    DR=$(/sbin/ip route 2>/dev/null | grep -m1 'default via.*wwan0' | sed -n 's/.*via \([0-9.]*\).*/\1/p')
    [ -z "$DR" ] && DR=none
    BDMUX_V=unknown; [ -n "$BDMUX" ] && [ -r "$BDMUX" ] && BDMUX_V=$(cat "$BDMUX" 2>/dev/null)
    # 链路状态机: 只用 modem 事实 (card/mm/ip), 不掺外网可达性
    if [ "$CARD" = absent ]; then
        LINK=no-card
    elif [ "$CARD" = unknown ]; then
        LINK=unknown
    elif [ "$MM_RUNNING" = false ]; then
        LINK=card-no-net
    elif [ "$MM_STATE" = connected ] && [ "$WWAN_IP" != none ]; then
        LINK=up
    elif [ "$MM_STATE" = failed ]; then
        LINK=net-down
    else
        LINK=activating
    fi
}

ping_once() {
    /bin/ping -c1 -W1 "$PING_TARGET" 2>/dev/null | grep -q '0% packet loss' && echo yes || echo no
}

cmd_card() {
    collect_card
    printf '{"state":"%s","slot1":"%s","usim":"%s"}\n' "$CARD_STATE" "$CARD_SLOT1" "$CARD_USIM"
}

cmd_status() {
    PING_OK=na
    [ "${1:-}" = --ping ] && PING_OK=$(ping_once)
    collect_status
    printf '{"link_state":"%s","card":"%s","mm_running":%s,"mm_state":"%s","signal":"%s","operator":"%s","nas":"%s","wwan_ip":"%s","default_route":"%s","ping":"%s","bdmux":"%s"}\n' \
        "$LINK" "$CARD" "$MM_RUNNING" "$MM_STATE" "$MM_SIGNAL" "$MM_OP" "$NAS" "$WWAN_IP" "$DR" "$PING_OK" "$BDMUX_V"
}

cmd_detail() {
    collect_status
    echo "=== SP970 link detail ==="
    echo "card   : $CARD  (slot1=$CARD_SLOT1 usim=$CARD_USIM)"
    echo "link   : $LINK"
    echo "mm     : running=$MM_RUNNING state=$MM_STATE"
    echo "signal : ${MM_SIGNAL:-na}   operator: ${MM_OP:-na}"
    echo "nas    : $NAS"
    echo "wwan0  : ip=$WWAN_IP default_route=$DR"
    echo "bdmux  : $BDMUX_V"
}

cmd_netcheck() {
    echo "ping $PING_TARGET : $(ping_once)"
    echo "ping baidu.com : $(/bin/ping -c1 -W1 baidu.com 2>/dev/null | grep -q '0% packet loss' && echo yes || echo no)"
}

cmd_up() {
    t0=$(date +%s)
    if [ "${1:-}" = --check ]; then
        # 只读预检: 报告当前状态 + 若执行 up 的计划动作, 不动系统
        collect_status
        if [ "$CARD" = no-card ] || [ "$CARD" = unknown ]; then PLAN=powercycle+sim-activate
        elif [ "$LINK" = up ]; then PLAN=noop
        else PLAN=sim-activate; fi
        printf '{"check":true,"card":"%s","link_state":"%s","mm_state":"%s","plan":"%s"}\n' \
            "$CARD" "$LINK" "$MM_STATE" "$PLAN"
        return 0
    fi
    # 1. 停 MM (干净, 让 sim-activate 的 -d 不争用)
    sudo -n rc-service modemmanager stop >/dev/null 2>&1
    sudo -n pkill -9 -f '/usr/sbin/ModemManager' >/dev/null 2>&1
    sleep 2
    # 2. 若卡 not present -> power-cycle 重见 (Test2 验证, 免 remoteproc)
    METHOD=sim-activate
    collect_card
    if [ "$CARD_SLOT1" != present ]; then
        sudo -n "$QMI" -d "$QMI_DEV" --uim-sim-power-off=1 >/dev/null 2>&1; sleep 1
        sudo -n "$QMI" -d "$QMI_DEV" --uim-sim-power-on=1 >/dev/null 2>&1; sleep 2
        METHOD=powercycle+sim-activate
        collect_card
        if [ "$CARD_SLOT1" != present ]; then
            t1=$(date +%s)
            printf '{"ok":false,"error":"no card after power-cycle","link_state":"no-card","method":"%s","duration_s":%s}\n' "$METHOD" "$((t1-t0))"
            return 1
        fi
    fi
    # 3. 跑 sim-activate (provision->ready + CFUN + reg + 起 MM), 全程不 remoteproc 重启
    sudo -n sh "$SIM_ACT" >/dev/null 2>&1
    # 4. probe
    collect_status
    t1=$(date +%s)
    ok=false; [ "$LINK" = up ] && ok=true
    printf '{"ok":%s,"link_state":"%s","method":"%s","duration_s":%s}\n' "$ok" "$LINK" "$METHOD" "$((t1-t0))"
}

case "${1:-}" in
    card)      cmd_card ;;
    status)    cmd_status "$2" ;;
    detail)    cmd_detail ;;
    netcheck)  cmd_netcheck ;;
    up)        cmd_up "$2" ;;
    *) echo "usage: $0 {card|status [--ping]|detail|netcheck|up [--check]}" >&2; exit 2 ;;
esac
