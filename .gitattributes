# 强制 LF (避免 CRLF 导致 busybox sh 解析异常)
*.sh text eol=lf
*.start text eol=lf
*.dts text eol=lf
*.dtsi text eol=lf
*.py text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.nmconnection text eol=lf
*.conf text eol=lf
*.scheme text eol=lf
VERSION text eol=lf
CHANGELOG.md text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf

# 无扩展名的设备端脚本 (busybox sh 解析，必须 LF)
scripts/sp970-expand-rootfs text eol=lf
scripts/sp970-link text eol=lf
LICENSE text eol=lf

